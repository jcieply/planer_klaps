{
  "name": "klaps-planer",
  "productName": "Klaps Planer",
  "version": "2.4.0",
  "description": "Klaps Planer – planowanie zdjęć filmowych: rozpiska, kalendarzówka, plan pracy, shotlista, ekipa, raport dzienny (aplikacja na komputer)",
  "main": "electron/main.js",
  "author": "Klaps Planer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dev": "electron .",
    "dist": "npm run prepare-app && electron-builder --publish never",
    "dist:mac": "npm run prepare-app && electron-builder --mac dmg --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win nsis --publish never",
    "test": "node test/store.test.js && node test/profile.test.js && node test/secrets.test.js",
    "e2e": "node test/electron.e2e.js",
    "e2e:cloud": "node test/electron-cloud.e2e.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.0.0",
    "@fontsource/barlow-condensed": "^5.0.0",
    "@fontsource/courier-prime": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "pdfjs-dist": "3.11.174",
    "playwright-core": "^1.55.0",
    "@fontsource/ibm-plex-mono": "^5.0.0"
  },
  "build": {
    "appId": "pl.klaps.planer",
    "productName": "Klaps Planer",
    "files": [
      "electron/**",
      "app/**",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Klaps Planer"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "Klaps-Planer-${version}-${os}-${arch}.${ext}"
  }
}

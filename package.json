{
  "name": "klaps-planer",
  "productName": "Klaps Planer",
  "version": "1.2.0",
  "description": "Klaps Planer – planowanie zdjęć: rozpiska, kalendarzówka, plan pracy, shotlista, ekipa (macOS i iOS)",
  "main": "electron/main.js",
  "author": "Klaps Planer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --mac dmg --publish never",
    "test": "node test/store.test.js",
    "prepare-ios": "node scripts/prepare.js ios",
    "ios": "npm run prepare-ios && node scripts/ios-setup.js --open",
    "ios-sync": "npm run prepare-ios && node scripts/ios-setup.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@fontsource/barlow-condensed": "^5.0.0",
    "@fontsource/courier-prime": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "pdfjs-dist": "3.11.174",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "build": {
    "appId": "pl.klaps.planer",
    "productName": "Klaps Planer",
    "files": [
      "electron/**",
      "app/**",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Klaps Planer"
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}